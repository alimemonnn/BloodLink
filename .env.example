# Copy to .env (never commit .env). Every value here is a placeholder.
# --- required in production -------------------------------------------------
BLOODLINK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname
ADMIN_EMAIL=you@example.org
ADMIN_PASSWORD=choose-a-strong-password-once
# --- business details shown in the footer and policies ----------------------
BUSINESS_NAME=BloodLink
BUSINESS_OPERATOR=Your Name (university project)
BUSINESS_ADDRESS=Sukkur, Sindh, Pakistan
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_REGISTRATION=
# --- optional email alerts (leave empty to use in-app notifications only) ---
PUBLIC_BASE_URL=https://your-site.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
