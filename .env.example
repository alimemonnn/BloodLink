# Copy this file to ".env" (same folder as app.py). The app reads it automatically.
# Never commit .env. Every value here is a placeholder.

# ---------------------------------------------------------------- local testing
# Nothing is required to run on your own computer. Add only what you want to try.
# Email links (password reset, confirm email) are printed in the terminal when SMTP is empty.

# ---------------------------------------------------------------- real email (optional)
# Gmail example. Use an APP PASSWORD (Google Account > Security > 2-Step Verification > App passwords),
# not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SMTP_FROM=BloodLink <yourname@gmail.com>
# SMTP_SECURITY=ssl            # only if your provider uses port 465
PUBLIC_BASE_URL=http://127.0.0.1:5000    # needed for donor alert emails (unsubscribe link). Use https://your-site on Render.

# ---------------------------------------------------------------- live website only (Render)
# Leave these commented out on your own computer. BLOODLINK_ENV=production switches on HTTPS-only cookies
# and makes seed.py refuse to run.
# BLOODLINK_ENV=production
# SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql://user:password@host/dbname
# ADMIN_EMAIL=you@example.org
# ADMIN_PASSWORD=choose-a-strong-password-once
# BUSINESS_NAME=BloodLink
# BUSINESS_OPERATOR=Your Name (university project)
# BUSINESS_ADDRESS=Sukkur, Sindh, Pakistan
# BUSINESS_EMAIL=
# BUSINESS_PHONE=
# BUSINESS_REGISTRATION=
