{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BloodLink: run the website",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PORT": "5000" }
    },
    {
      "name": "BloodLink: run with auto-reload (edit and refresh)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PORT": "5000", "FLASK_DEBUG": "1" }
    },
    {
      "name": "BloodLink: debug with breakpoints",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PORT": "5000", "FLASK_DEBUG": "1", "BLOODLINK_RELOAD": "0" }
    },
    {
      "name": "BloodLink: add demo data (empty database only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/seed.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "BloodLink: run background jobs once",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "app", "jobs"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "BloodLink: run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
